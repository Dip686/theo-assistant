{
  "name": "theo",
  "version": "1.2.0",
  "description": "Desktop avatar assistant that reminds you to take breaks",
  "author": "Dip686",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac",
    "package:dmg": "electron-vite build && electron-builder --mac dmg",
    "package:zip": "electron-vite build && electron-builder --mac zip"
  },
  "build": {
    "appId": "com.dip686.theo",
    "productName": "Theo",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Theo",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png"
    }
  },
  "dependencies": {
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.5.2"
  }
}
